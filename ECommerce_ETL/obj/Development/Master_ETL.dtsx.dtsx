                      SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT 1 FROM stg.ETL_LoadControl &#xA;    WHERE TableName = 'stg.SellerContract'&#xA;)&#xA;BEGIN&#xA;    INSERT INTO stg.ETL_LoadControl&#xA;    (&#xA;        TableName,&#xA;        LastSuccessfulLoad,&#xA;        LastLoadStatus,&#xA;        CreatedAt&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        'stg.SellerContract',&#xA;        NULL,&#xA;        'Never',&#xA;        SYSDATETIME()&#xA;    );&#xA;END;&#xA;&#xA;UPDATE stg.ETL_LoadControl&#xA;SET LastLoadStartTime = SYSDATETIME(),&#xA;    LastLoadStatus = 'Running',&#xA;    UpdatedAt = SYSDATETIME()&#xA;WHERE TableName = 'stg.SellerContract';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
