                    <SQLTask:SqlTaskData
                      SQLTask:Connection="{A04657EA-0B1D-4415-9C1A-1364727D118D}"
                      SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT 1 FROM stg.ETL_LoadControl &#xA;    WHERE TableName = 'stg.Inventory'&#xA;)&#xA;BEGIN&#xA;    INSERT INTO stg.ETL_LoadControl&#xA;    (&#xA;        TableName,&#xA;        LastSuccessfulLoad,&#xA;        LastLoadStatus,&#xA;        CreatedAt&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        'stg.Inventory',&#xA;        NULL,&#xA;        'Never',&#xA;        SYSDATETIME()&#xA;    );&#xA;END;&#xA;&#xA;UPDATE stg.ETL_LoadControl&#xA;SET LastLoadStartTime = SYSDATETIME(),&#xA;    LastLoadStatus = 'Running',&#xA;    UpdatedAt = SYSDATETIME()&#xA;WHERE TableName = 'stg.Inventory';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
                  </DTS:ObjectData>
                </DTS:Executable>
