                      SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT 1 &#xA;    FROM stg.ETL_LoadControl &#xA;    WHERE TableName = 'stg.Shipment'&#xA;)&#xA;BEGIN&#xA;    INSERT INTO stg.ETL_LoadControl&#xA;    (&#xA;        TableName,&#xA;        LastSuccessfulLoad,&#xA;        LastLoadStatus,&#xA;        CreatedAt&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        'stg.Shipment',&#xA;        '1900-01-01',&#xA;        'Never',&#xA;        SYSDATETIME()&#xA;    );&#xA;END&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
