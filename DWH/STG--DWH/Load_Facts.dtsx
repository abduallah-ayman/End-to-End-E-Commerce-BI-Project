              SQLTask:SqlStatementSource="UPDATE stg.ETL_LoadControl&#xA;&#xA;SET&#xA; &#xA;    LastLoadStartTime = SYSDATETIME(),&#xA;         LastLoadStatus = 'Running',&#xA;&#xA;    UpdatedAt = SYSDATETIME()&#xA;&#xA;WHERE TableName = ?;&#xA;&#xA;&#xA;&#xA;SELECT &#xA;    LastSuccessfulLoad&#xA;&#xA;FROM stg.ETL_LoadControl&#xA;&#xA;WHERE TableName = ?;"
