            <SQLTask:SqlTaskData
              SQLTask:Connection="{30F793FF-5039-4B3A-B3B8-826C2447EF04}"
              SQLTask:SqlStatementSource="UPDATE stg.ETL_LoadControl&#xA;&#xA;SET&#xA; &#xA;    LastLoadStartTime = SYSDATETIME(),&#xA;         LastLoadStatus = 'Running',&#xA;&#xA;    UpdatedAt = SYSDATETIME()&#xA;&#xA;WHERE TableName = ?;&#xA;&#xA;&#xA;&#xA;SELECT &#xA;    LastSuccessfulLoad&#xA;&#xA;FROM stg.ETL_LoadControl&#xA;&#xA;WHERE TableName = ?;"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::LastSuccessfulLoad" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::Tablename"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::Tablename"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="-1" />
