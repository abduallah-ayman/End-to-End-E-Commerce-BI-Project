              SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT 1 &#xA;    FROM ctl.ETL_TableLoadControl&#xA;    WHERE TableName = ?&#xA;)&#xA;BEGIN&#xA;    INSERT INTO ctl.ETL_TableLoadControl&#xA;    (&#xA;        TableName,&#xA;        LastSuccessfulLoad,&#xA;        LastLoadStatus,&#xA;        UpdatedAt&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        ?,&#xA;        NULL,&#xA;        'Never',&#xA;        SYSDATETIME()&#xA;    );&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
